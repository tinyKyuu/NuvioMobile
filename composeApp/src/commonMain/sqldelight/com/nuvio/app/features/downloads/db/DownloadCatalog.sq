CREATE TABLE download_catalog_entry (
    download_id TEXT NOT NULL PRIMARY KEY,
    owner_profile_key TEXT NOT NULL,
    record_version INTEGER NOT NULL,
    logical_content_key TEXT NOT NULL,
    transport_kind TEXT NOT NULL,
    internal_state TEXT NOT NULL,
    state_reason TEXT,
    relative_media_path TEXT,
    platform_session_id TEXT,
    platform_task_identifier INTEGER,
    last_event_id TEXT,
    item_payload TEXT NOT NULL,
    downloaded_bytes INTEGER NOT NULL,
    expected_bytes INTEGER,
    created_at_epoch_ms INTEGER NOT NULL,
    started_at_epoch_ms INTEGER,
    updated_at_epoch_ms INTEGER NOT NULL,
    completed_at_epoch_ms INTEGER
);

CREATE INDEX download_catalog_entry_profile
ON download_catalog_entry(owner_profile_key, created_at_epoch_ms);

selectForProfile:
SELECT *
FROM download_catalog_entry
WHERE owner_profile_key = ?
ORDER BY created_at_epoch_ms DESC, download_id DESC;

selectById:
SELECT *
FROM download_catalog_entry
WHERE download_id = ?;

selectAll:
SELECT *
FROM download_catalog_entry
ORDER BY created_at_epoch_ms DESC, download_id DESC;

upsert:
INSERT OR REPLACE INTO download_catalog_entry(
    download_id,
    owner_profile_key,
    record_version,
    logical_content_key,
    transport_kind,
    internal_state,
    state_reason,
    relative_media_path,
    platform_session_id,
    platform_task_identifier,
    last_event_id,
    item_payload,
    downloaded_bytes,
    expected_bytes,
    created_at_epoch_ms,
    started_at_epoch_ms,
    updated_at_epoch_ms,
    completed_at_epoch_ms
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM download_catalog_entry
WHERE download_id = ?;

deleteForProfile:
DELETE FROM download_catalog_entry
WHERE owner_profile_key = ?;

CREATE TABLE offline_title_record (
    record_key TEXT NOT NULL PRIMARY KEY,
    owner_profile_key TEXT NOT NULL,
    meta_type TEXT NOT NULL,
    meta_id TEXT NOT NULL,
    record_version INTEGER NOT NULL,
    generation INTEGER NOT NULL,
    payload TEXT NOT NULL,
    created_at_epoch_ms INTEGER NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL
);

CREATE INDEX offline_title_record_profile
ON offline_title_record(owner_profile_key, updated_at_epoch_ms);

selectOfflineTitlesForProfile:
SELECT *
FROM offline_title_record
WHERE owner_profile_key = ?
ORDER BY updated_at_epoch_ms DESC, record_key ASC;

selectOfflineTitleByKey:
SELECT *
FROM offline_title_record
WHERE record_key = ?;

selectAllOfflineTitles:
SELECT *
FROM offline_title_record
ORDER BY updated_at_epoch_ms DESC, record_key ASC;

upsertOfflineTitle:
INSERT OR REPLACE INTO offline_title_record(
    record_key,
    owner_profile_key,
    meta_type,
    meta_id,
    record_version,
    generation,
    payload,
    created_at_epoch_ms,
    updated_at_epoch_ms
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteOfflineTitleByKey:
DELETE FROM offline_title_record
WHERE record_key = ?;

deleteOfflineTitlesForProfile:
DELETE FROM offline_title_record
WHERE owner_profile_key = ?;
