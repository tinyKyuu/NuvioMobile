#include? "Version.xcconfig"

// Public defaults for the internal TestFlight fork. Personal team selection lives
// in the ignored Signing.local.xcconfig file.
NUVIO_DEVELOPMENT_TEAM=
NUVIO_APP_BUNDLE_IDENTIFIER=com.tinykyuu.nuvio.internal
NUVIO_WIDGET_BUNDLE_IDENTIFIER=$(NUVIO_APP_BUNDLE_IDENTIFIER).DownloadsWidgetExtension
NUVIO_DISPLAY_NAME=Nuvio

#include? "Signing.local.xcconfig"

PRODUCT_NAME=$(NUVIO_DISPLAY_NAME)
